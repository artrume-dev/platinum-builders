{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ES2015",
    "lib": ["DOM", "ES2018"],
    "outDir": "./js",
    "rootDir": "./ts",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["ts/**/*"]
}
